# Vercel Deployment Environment Variables

# The public URL of your Python Backend (e.g. from Ngrok or Cloudflare Tunnel)
# Leave empty for local development (will default to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=

# The WebSocket URL of your Python Backend (e.g. wss://your-ngrok-url.app)
# Leave empty for local development (will default to ws://127.0.0.1:8000)
NEXT_PUBLIC_WS_URL=
