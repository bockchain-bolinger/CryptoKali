# Server Configuration
SPOT_EXCHANGE=binance
FUTURES_EXCHANGE=binanceusdm
QUOTE=USDT

# Trading Params
TF_SIGNAL=1h
TF_FILTER=4h
LIMIT_SIGNAL=400
LIMIT_FILTER=250
MIN_QUOTE_VOLUME_USD_SPOT=5000000.0
MIN_QUOTE_VOLUME_USD_FUT=20000000.0
TOP_N=30
ACCOUNT_EQUITY=10000.0
RISK_PCT_PER_TRADE=0.01

# Liquidity Guardrails
LIQ_TEST_NOTIONAL_USD=10000.0
LIQ_MAX_SPREAD_PCT=0.0015
LIQ_MAX_SLIPPAGE_PCT_10K=0.0025
LIQ_REQUIRE_FILLED_10K=true

# Costs
FEES_BPS=6.0
SLIPPAGE_BPS=3.0

# Notifications (Add your keys here)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Infrastructure
DB_PATH=cryptokali.sqlite
SCAN_INTERVAL_SECONDS=300

# API Credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

